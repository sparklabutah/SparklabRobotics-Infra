<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>capx_sparklab</name>
  <version>0.1.0</version>
  <description>cap-x's SparkLab tool surface on the bimanual YAM-Ultra rig: low-level env over ROS 2, two-arm tools, robot description.</description>
  <maintainer email="phdminh01@gmail.com">SparkLab</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>sparklab_yam</exec_depend>
  <!-- not rosdep: cap-x, cuRobo, GraspGenX; run under scripts/capx_python.sh -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
