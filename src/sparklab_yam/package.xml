<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sparklab_yam</name>
  <version>0.2.0</version>
  <description>Bimanual i2rt YAM-Ultra: arm driver, Quest teleop node, IK, model, rig config and bring-up launch.</description>
  <maintainer email="phdminh01@gmail.com">SparkLab</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sparklab_quest</exec_depend>
  <exec_depend>sparklab_cameras</exec_depend>
  <!-- pip, no rosdep key: mujoco, i2rt -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
